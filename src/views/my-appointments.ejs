<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <section class="section" style="margin-bottom: 24px;">
      <div class="page-heading" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
        <div>
          <h1 style="font-size:32px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
            📑 Consultation Bookings & History
          </h1>
          <p class="meta" style="font-size:16px; color:var(--neutral-500); margin:0;">
            Track your consultations, join virtual telehealth rooms, and manage bookings.
          </p>
        </div>
        <a class="button" href="/dieticians">Schedule New Session</a>
      </div>
    </section>

    <% if (!appointments || appointments.length === 0) { %>
      <div class="card-glass" style="text-align:center; padding:48px;">
        <h3 style="margin:0 0 8px;">No Consultations Found</h3>
        <p style="color:var(--neutral-500); margin:0 0 16px;">You haven't scheduled any sessions yet.</p>
        <a href="/dieticians" class="button">Find a Dietician</a>
      </div>
    <% } else { %>
      <div style="display:grid; gap:18px;">
        <% appointments.forEach(function(a) { %>
          <div class="card-glass">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
              <div>
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                  <h3 style="margin:0; font-size:19px; font-weight:800; color:var(--neutral-900);">
                    <%= a.dietician && a.dietician.user ? a.dietician.user.name : 'Clinical Specialist' %>
                  </h3>
                  <span class="badge-pill <%= a.status === 'completed' ? 'badge-success' : (a.status === 'booked' ? 'badge-info' : 'badge-danger') %>">
                    <%= a.status.toUpperCase() %>
                  </span>
                </div>

                <div style="font-size:14px; color:var(--neutral-500); margin-bottom:8px;">
                  <span>🗓️ <%= new Date(a.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  <span style="margin:0 8px;">•</span>
                  <span>Mode: <strong><%= a.mode.toUpperCase() %></strong></span>
                  <span style="margin:0 8px;">•</span>
                  <strong style="color:var(--primary-emerald-dark);">Fee: ₹<%= a.amount || (a.dietician ? a.dietician.fee : 600) %></strong>
                </div>

                <% if (a.notes) { %>
                  <p style="margin:6px 0 0; font-size:14px; color:var(--neutral-700);">
                    <strong>Notes:</strong> <%= a.notes %>
                  </p>
                <% } %>

                <% if (a.dieticianNotes) { %>
                  <p style="margin:6px 0 0; font-size:14px; color:var(--primary-emerald-dark);">
                    <strong>Dietician Clinical Notes:</strong> <%= a.dieticianNotes %>
                  </p>
                <% } %>
              </div>

              <!-- Right Actions -->
              <div style="display:flex; flex-direction:column; gap:8px; align-items:flex-end;">
                <% if (a.meetingLink && a.status === 'booked') { %>
                  <a href="<%= a.meetingLink %>" target="_blank" class="button" style="background:#0284c7; color:#fff; display:inline-flex; align-items:center; gap:6px;">
                    📹 Join Telehealth Video
                  </a>
                <% } %>

                <% if (a.status === 'booked') { %>
                  <div style="display:flex; gap:8px;">
                    <form action="/appointments/remind/<%= a._id %>" method="post" style="margin:0;">
                      <button type="submit" class="btn-sm-action btn-swap">🔔 Send Reminder</button>
                    </form>
                    <button type="button" onclick="openCancelModal('<%= a._id %>')" class="btn-sm-action btn-skip" style="color:#b91c1c;">
                      Cancel
                    </button>
                  </div>
                <% } %>

                <% if (a.status === 'cancelled') { %>
                  <div style="color:#b91c1c; font-size:12px; margin-top:4px;">
                    Reason: <%= a.cancelReason || 'Cancelled by user' %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- Cancel Modal -->
    <div id="cancelModalOverlay" class="modal-overlay">
      <div class="modal-dialog-box" style="max-width:480px;">
        <h3 style="margin:0 0 12px; font-size:20px; font-weight:800; color:var(--neutral-900);">Cancel Consultation</h3>
        <p style="margin:0 0 16px; font-size:14px; color:var(--neutral-500);">
          Please state the reason for cancellation so the dietician can adjust their calendar:
        </p>

        <form id="cancelForm" method="post" style="display:grid; gap:14px;">
          <div class="field">
            <textarea name="reason" class="field-input" rows="3" placeholder="e.g. Schedule conflict, feeling unwell..." required></textarea>
          </div>
          <div style="display:flex; justify-content:flex-end; gap:10px;">
            <button type="button" class="btn btn-secondary" onclick="closeCancelModal()">Keep Appointment</button>
            <button type="submit" class="btn-ai" style="background:#b91c1c; border-color:#991b1b;">Confirm Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <%- include('partials/footer') %>
  </div>

  <script>
    function openCancelModal(id) {
      document.getElementById('cancelForm').action = '/appointments/cancel/' + id;
      document.getElementById('cancelModalOverlay').classList.add('active');
    }

    function closeCancelModal() {
      document.getElementById('cancelModalOverlay').classList.remove('active');
    }
  </script>
</body>
</html>
