<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <div class="card-glass" style="max-width:680px; margin:32px auto;">
      <h2 style="font-size:26px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
        ⭐ Share Your Transformation Story
      </h2>
      <p class="meta" style="font-size:15px; color:var(--neutral-500); margin:0 0 24px;">
        Inspire patients in our community with your health transformation and dietary consistency journey.
      </p>

      <form action="/share-story" method="post" style="display:grid; gap:16px;">
        <div class="field">
          <label style="font-weight:700; font-size:13px;">Your Name or Pseudonym</label>
          <input type="text" name="name" class="field-input" placeholder="e.g. Sweatha A." value="<%= currentUser ? currentUser.name : '' %>">
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
          <div class="field">
            <label style="font-weight:700; font-size:13px;">Starting Weight (kg)</label>
            <input type="number" step="0.1" name="beforeWeight" class="field-input" placeholder="e.g. 74.0">
          </div>
          <div class="field">
            <label style="font-weight:700; font-size:13px;">Current Weight (kg)</label>
            <input type="number" step="0.1" name="afterWeight" class="field-input" placeholder="e.g. 64.5">
          </div>
          <div class="field">
            <label style="font-weight:700; font-size:13px;">Duration</label>
            <input type="text" name="duration" class="field-input" placeholder="e.g. 3 months">
          </div>
        </div>

        <div class="field">
          <label style="font-weight:700; font-size:13px;">Your Story & Experience with The Balanced Bowl</label>
          <textarea name="story" class="field-input" rows="5" placeholder="Share what worked for you, how the meal swapper helped you stay consistent, and how your dietician guided you..." required></textarea>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:8px;">
          <a href="/" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn-ai" style="padding:12px 28px;">Submit Transformation</button>
        </div>
      </form>
    </div>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
