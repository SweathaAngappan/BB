<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <div class="card-glass" style="max-width:780px; margin:24px auto;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; padding-bottom:16px; border-bottom:1px solid var(--neutral-100); flex-wrap:wrap; gap:16px;">
        <div>
          <h2 style="font-size:26px; font-weight:800; color:var(--neutral-900); margin:0 0 4px;">
            Secure Consultation Checkout
          </h2>
          <p class="meta" style="font-size:15px; color:var(--neutral-500); margin:0;">
            Dietician: <strong><%= dietician.user ? dietician.user.name : 'Clinical Specialist' %></strong>
          </p>
        </div>
        <div style="text-align:right;">
          <div style="font-size:26px; font-weight:800; color:var(--primary-emerald-dark);">
            ₹<%= dietician.fee || 600 %>
          </div>
          <div style="font-size:13px; color:var(--neutral-500);">Scheduled: <%= new Date(date).toLocaleDateString() %></div>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:1.2fr 1fr; gap:28px; align-items:flex-start;">
        
        <!-- Left: Payment details & Form -->
        <div>
          <h3 style="margin:0 0 14px; font-size:17px; font-weight:700;">Select Payment Method</h3>
          
          <div style="display:grid; gap:12px; margin-bottom:20px;">
            <label style="border:2px solid var(--primary-emerald); background:#f0fdf4; border-radius:16px; padding:16px; display:flex; align-items:center; gap:12px; cursor:pointer;">
              <input type="radio" name="payMethod" value="simulated" checked style="accent-color:var(--primary-emerald); width:18px; height:18px;">
              <div>
                <strong style="color:var(--neutral-900); font-size:15px;">UPI / Instant Payment Confirmation</strong>
                <div style="font-size:13px; color:var(--neutral-500);">Instant booking with Google Pay, PhonePe, or Net Banking</div>
              </div>
            </label>

            <label style="border:1px solid var(--neutral-200); background:#fff; border-radius:16px; padding:16px; display:flex; align-items:center; gap:12px; cursor:pointer;">
              <input type="radio" name="payMethod" value="card" style="accent-color:var(--primary-emerald); width:18px; height:18px;">
              <div>
                <strong style="color:var(--neutral-900); font-size:15px;">Credit / Debit Card</strong>
                <div style="font-size:13px; color:var(--neutral-500);">Visa, Mastercard, RuPay processed securely</div>
              </div>
            </label>
          </div>

          <form action="/appointments/pay" method="post" style="margin-top:16px;">
            <input type="hidden" name="dieticianId" value="<%= dietician._id %>">
            <input type="hidden" name="date" value="<%= date %>">
            <input type="hidden" name="mode" value="<%= mode %>">
            <input type="hidden" name="notes" value="<%= notes %>">

            <button type="submit" class="btn-ai" style="width:100%; justify-content:center; padding:16px; font-size:16px;">
              🔒 Confirm & Pay ₹<%= dietician.fee || 600 %>
            </button>
          </form>

          <p style="text-align:center; margin:12px 0 0; font-size:12px; color:var(--neutral-500);">
            🛡️ 256-Bit SSL Encrypted. Auto-generates meeting room and email confirmation.
          </p>
        </div>

        <!-- Right: QR Code / Summary Box -->
        <div style="background:#f8fafc; border:1px solid var(--neutral-200); border-radius:20px; padding:22px; text-align:center;">
          <h4 style="margin:0 0 12px; font-size:16px; font-weight:700;">Direct UPI QR Code</h4>
          
          <div style="background:#fff; padding:14px; border-radius:16px; display:inline-block; box-shadow:0 6px 18px rgba(0,0,0,0.06);">
            <% if (dietician.qrCodeUrl) { %>
              <img src="<%= dietician.qrCodeUrl %>" alt="Dietician UPI QR" style="width:180px; height:180px; border-radius:10px; object-fit:cover;">
            <% } else { %>
              <!-- Clean SVG Fallback QR Pattern -->
              <svg viewBox="0 0 100 100" style="width:160px; height:160px;">
                <rect width="100" height="100" fill="#ffffff" />
                <rect x="10" y="10" width="25" height="25" fill="#0f172a" />
                <rect x="15" y="15" width="15" height="15" fill="#ffffff" />
                <rect x="65" y="10" width="25" height="25" fill="#0f172a" />
                <rect x="70" y="15" width="15" height="15" fill="#ffffff" />
                <rect x="10" y="65" width="25" height="25" fill="#0f172a" />
                <rect x="15" y="70" width="15" height="15" fill="#ffffff" />
                <rect x="42" y="15" width="8" height="20" fill="#0f172a" />
                <rect x="42" y="45" width="16" height="16" fill="#10b981" />
                <rect x="65" y="45" width="15" height="8" fill="#0f172a" />
                <rect x="65" y="65" width="25" height="25" fill="#0f172a" />
                <rect x="40" y="70" width="12" height="18" fill="#0f172a" />
              </svg>
            <% } %>
          </div>

          <div style="margin-top:12px; font-size:13px; color:var(--neutral-700);">
            UPI ID: <strong><%= dietician.upiId || 'payments@balancedbowl' %></strong>
          </div>
          <div style="font-size:12px; color:var(--neutral-500); margin-top:4px;">
            Consultation Mode: <strong><%= mode.toUpperCase() %></strong>
          </div>
        </div>

      </div>
    </div>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
