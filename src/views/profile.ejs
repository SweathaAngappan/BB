<!doctype html>
<html>
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <div class="form-card" style="max-width:900px;margin:18px auto;">
      <div class="page-heading">
        <div>
          <h2>Profile — <%= user.name %></h2>
          <p class="meta">Role: <%= user.role %> • Email: <%= user.email %></p>
        </div>
        <a class="button" href="/share-story">Share story</a>
      </div>

      <% if (user.role === 'user') { %>
        <div class="plan-overview">
          <div class="plan-card">
            <h3>Your details</h3>
            <ul style="padding-left:18px; margin:0; color:var(--muted);">
              <li>Phone: <%= user.phone || '—' %></li>
              <li>Age: <%= user.age || '—' %></li>
              <li>Height: <%= user.height || '—' %> cm</li>
              <li>Weight: <%= user.weight || '—' %> kg</li>
            </ul>
          </div>
          <div class="plan-card">
            <h3>Share your success story</h3>
            <p class="meta">Have progress to share? Email us or use the contact form (coming soon).</p>
            <a class="btn" href="/contact">Share your story</a>
          </div>
        </div>
      <% } else if (user.role === 'dietician') { %>
        <div class="plan-card">
          <h3>Professional profile</h3>
          <% if (dietician) { %>
            <p>Experience: <%= dietician.experienceYears %> years • Fee: ₹<%= dietician.fee %></p>
            <p>Specializations: <%= (dietician.specialization || []).join(', ') || '—' %></p>
            <p>Certificates: <%= (dietician.certificates || []).join(', ') || '—' %></p>
            <p>Consultation modes: <%= (dietician.consultationModes || []).join(', ') %></p>
          <% } else { %>
            <p class="meta">No dietician profile yet.</p>
          <% } %>
        </div>
      <% } %>
    </div>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
