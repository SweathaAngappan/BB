<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <!-- Header Section -->
    <section class="section" style="margin-bottom: 20px;">
      <div class="page-heading" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
        <div>
          <div style="display:flex; align-items:center; gap:10px;">
            <h1 style="font-size:28px; font-weight:800; color:var(--neutral-900); margin:0;">
              🩺 Clinical Patient Roster
            </h1>
            <% if (alertCount > 0) { %>
              <span class="badge-pill badge-warning" style="font-size:12px;">
                ⚡ <%= alertCount %> Action Alert<%= alertCount > 1 ? 's' : '' %>
              </span>
            <% } %>
          </div>
          <p class="meta" style="font-size:14px; color:var(--neutral-500); margin:4px 0 0;">
            Metabolic monitoring, compliance tracking, and meal planning
          </p>
        </div>
        <a class="button" href="/dieticians/profile">My Practice Settings</a>
      </div>
    </section>

    <!-- Client Cards Grid -->
    <div style="display:grid; gap:18px;">
      <% if (!clients || clients.length === 0) { %>
        <div class="card-glass" style="text-align:center; padding:40px;">
          <h3 style="margin:0 0 6px;">No Active Clients Booked</h3>
          <p style="color:var(--neutral-500); margin:0; font-size:14px;">When patients book consultations, their patient cards appear here.</p>
        </div>
      <% } else { %>
        <% clients.forEach(function(item) { %>
          <% const client = item.client; %>
          <% const meta = item.metabolicStatus; %>
          <% const plan = planMap[client._id.toString()]; %>
          <% const appt = item.latestAppointment; %>

          <div class="card-glass" style="border-left: 6px solid <%= meta.status === 'plateau_warning' ? '#f59e0b' : (meta.status === 'at_risk' ? '#f43f5e' : '#10b981') %>; padding:22px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:18px;">
              
              <!-- Client Bio & Demographics -->
              <div style="flex:1; min-width:280px;">
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
                  <div style="width:44px; height:44px; border-radius:12px; background:var(--primary-emerald-light); color:var(--primary-emerald-dark); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:17px;">
                    <%= client.name ? client.name.charAt(0) : 'C' %>
                  </div>
                  <div>
                    <strong style="font-size:17px; color:var(--neutral-900);"><%= client.name %></strong>
                    <div style="font-size:13px; color:var(--neutral-500);"><%= client.email %> • <%= client.phone || 'No phone' %></div>
                  </div>
                </div>

                <!-- Physical & Dietary Stats -->
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin:10px 0;">
                  <span class="macro-chip" style="font-size:12px;">Weight: <%= client.weight ? client.weight + ' kg' : '--' %></span>
                  <span class="macro-chip" style="font-size:12px;">Target: <%= client.targetWeight ? client.targetWeight + ' kg' : 'Maintenance' %></span>
                  <span class="macro-chip" style="font-size:12px;">Diet: <%= client.dietaryPreference || 'all' %></span>
                  <% if (client.allergies && client.allergies.length > 0) { %>
                    <span class="macro-chip fats" style="font-size:12px;">Allergy: <%= client.allergies.join(', ') %></span>
                  <% } %>
                  <% if (client.healthConditions && client.healthConditions.length > 0) { %>
                    <span class="macro-chip carbs" style="font-size:12px;">Condition: <%= client.healthConditions.join(', ') %></span>
                  <% } %>
                </div>

                <!-- Latest Appointment Info -->
                <div style="font-size:13px; color:var(--neutral-500); margin-top:8px;">
                  Consultation: <strong><%= new Date(appt.date).toLocaleDateString() %> (<%= appt.mode %>)</strong>
                  <span class="badge-pill <%= appt.status === 'completed' ? 'badge-success' : 'badge-info' %>" style="margin-left:6px; font-size:11px; padding:2px 8px;">
                    <%= appt.status %>
                  </span>
                </div>
              </div>

              <!-- Feature 3: Clinical Adherence & Metabolic Intelligence Widget -->
              <div style="background:#ffffff; border:1px solid var(--neutral-200); border-radius:16px; padding:16px; min-width:280px; max-width:360px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                  <span style="font-size:11px; font-weight:700; color:var(--neutral-500); text-transform:uppercase;">Metabolic Evaluation</span>
                  <span class="badge-pill <%= meta.badgeClass %>" style="font-size:11px;"><%= meta.label %></span>
                </div>

                <div style="display:flex; align-items:baseline; gap:8px; margin-bottom:6px;">
                  <div style="font-size:24px; font-weight:800; color:var(--primary-emerald-dark);"><%= meta.adherenceRate7Day %>%</div>
                  <div style="font-size:12px; color:var(--neutral-500);">7-Day Adherence</div>
                </div>

                <p style="font-size:12px; color:var(--neutral-700); margin:0 0 12px; line-height:1.4;">
                  <%= meta.clinicalAlert %>
                </p>

                <!-- Actions -->
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                  <a href="/dieticians/plan/<%= client._id %>" class="btn-ai" style="padding:8px 14px; font-size:12px; text-decoration:none;">
                    <%= plan ? '✏️ Calibrate 7-Day Plan' : '+ Create 7-Day Plan' %>
                  </a>

                  <% if (appt.status === 'booked') { %>
                    <form action="/appointments/complete/<%= appt._id %>" method="post" style="margin:0;">
                      <button type="submit" class="btn-sm-action btn-eaten" style="padding:8px 12px; font-size:12px;">
                        ✔ Complete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>

            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
