<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <div class="auth-layout" style="display:grid; grid-template-columns:1.3fr 1fr; gap:32px; max-width:980px; margin:32px auto; align-items:start;">
      <div class="card-glass">
        <h1 style="font-size:28px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
          Create Your Account
        </h1>
        <p class="meta" style="font-size:15px; color:var(--neutral-500); margin:0 0 20px;">
          Join The Balanced Bowl — personalized AI nutrition, verified clinical dieticians, and smart pantry swapper.
        </p>

        <form action="/register" method="post" enctype="multipart/form-data" style="display:grid; gap:16px;">
          
          <div class="field">
            <label style="font-weight:700; font-size:13px;">I am registering as a</label>
            <select name="role" id="roleSelect" class="field-input" style="font-weight:700;">
              <option value="user">User / Patient (Looking for Nutrition Plans)</option>
              <option value="dietician">Certified Clinical Dietician (Healthcare Provider)</option>
            </select>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
            <div class="field">
              <label style="font-weight:700; font-size:13px;">Full Name</label>
              <input type="text" name="name" class="field-input" placeholder="e.g. Sweatha Angappan" required>
            </div>
            <div class="field">
              <label style="font-weight:700; font-size:13px;">Email Address</label>
              <input type="email" name="email" class="field-input" placeholder="e.g. sweatha@example.com" required>
            </div>
          </div>

          <div class="field">
            <label style="font-weight:700; font-size:13px;">Password</label>
            <div style="position:relative;">
              <input type="password" id="password" name="password" class="field-input" placeholder="Minimum 8 characters" required style="width:100%; padding-right:42px;">
              <span id="togglePassword" style="position:absolute; right:14px; top:50%; transform:translateY(-50%); cursor:pointer;">👁️</span>
            </div>
          </div>

          <!-- USER SPECIFIC FIELDS -->
          <div id="userFields" style="display:grid; gap:14px;">
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Phone</label>
                <input type="text" name="u_phone" class="field-input" placeholder="+91 98765 00000">
              </div>
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Age (yrs)</label>
                <input type="number" name="u_age" class="field-input" placeholder="24">
              </div>
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Gender</label>
                <select name="u_gender" class="field-input">
                  <option value="female">Female</option>
                  <option value="male">Male</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Height (cm)</label>
                <input type="number" name="u_height" class="field-input" placeholder="165">
              </div>
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Weight (kg)</label>
                <input type="number" step="0.1" name="u_weight" class="field-input" placeholder="62.5">
              </div>
            </div>

            <div class="field">
              <label style="font-weight:700; font-size:13px;">Dietary Preference</label>
              <select name="u_dietaryPreference" class="field-input">
                <option value="vegetarian">Vegetarian</option>
                <option value="vegan">Vegan</option>
                <option value="eggetarian">Eggetarian</option>
                <option value="non-vegetarian">Non-Vegetarian</option>
                <option value="jain">Jain</option>
                <option value="all">Flexible</option>
              </select>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="field">
                <label style="font-weight:700; font-size:13px; color:#b91c1c;">Known Allergies</label>
                <input type="text" name="u_allergies" class="field-input" placeholder="e.g. lactose, peanuts, gluten">
              </div>
              <div class="field">
                <label style="font-weight:700; font-size:13px; color:#b45309;">Health Conditions</label>
                <input type="text" name="u_conditions" class="field-input" placeholder="e.g. diabetes, pcos, hypertension">
              </div>
            </div>
          </div>

          <!-- DIETICIAN SPECIFIC FIELDS -->
          <div id="dieticianFields" style="display:none; gap:14px;">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Phone Number</label>
                <input type="text" name="d_phone" class="field-input" placeholder="+91 98765 11111">
              </div>
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Experience (Years)</label>
                <input type="number" name="d_experienceYears" class="field-input" placeholder="5">
              </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Consultation Fee (₹)</label>
                <input type="number" name="d_fee" class="field-input" placeholder="600">
              </div>
              <div class="field">
                <label style="font-weight:700; font-size:13px;">Consultation Modes</label>
                <input type="text" name="d_modes" class="field-input" placeholder="online, in-person">
              </div>
            </div>

            <div class="field">
              <label style="font-weight:700; font-size:13px;">Specializations (comma separated)</label>
              <input type="text" name="d_specialization" class="field-input" placeholder="e.g. Weight Loss, Sports Nutrition, Diabetes Reversal">
            </div>

            <div class="field">
              <label style="font-weight:700; font-size:13px;">Board Certifications / Degrees (PDF / Images)</label>
              <input type="file" name="d_certificates" multiple accept=".pdf,.jpg,.jpeg,.png" class="field-input">
            </div>

            <div class="field">
              <label style="font-weight:700; font-size:13px;">Clinical Bio & Expertise</label>
              <textarea name="d_bio" class="field-input" rows="2" placeholder="Tell patients about your clinical experience and dietary philosophy..."></textarea>
            </div>
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px;">
            <button type="submit" class="btn-ai" style="padding:14px 32px;">Create Account</button>
            <a href="/login" style="font-size:14px; color:var(--primary-emerald-dark); font-weight:700; text-decoration:none;">Already have an account? Sign In →</a>
          </div>
        </form>
      </div>

      <div class="card-glass" style="text-align:center; padding:32px;">
        <div style="width:100%; border-radius:20px; overflow:hidden; margin-bottom:18px;">
          <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600&q=60&auto=format&fit=crop" alt="Healthy food" style="width:100%; height:auto; display:block;">
        </div>
        <h3 style="margin:0 0 6px; font-size:18px; font-weight:700;">Start Your Transformation</h3>
        <p class="meta" style="font-size:14px; color:var(--neutral-500); margin:0;">
          Unlock customized 7-day nutrition plans, automated grocery shopping lists, and AI food plate insights.
        </p>
      </div>
    </div>

    <%- include('partials/footer') %>
  </div>

  <script>
    document.getElementById("roleSelect").addEventListener("change", function() {
      const isUser = this.value === "user";
      document.getElementById("userFields").style.display = isUser ? "grid" : "none";
      document.getElementById("dieticianFields").style.display = isUser ? "none" : "grid";
    });

    const pwdInput = document.getElementById("password");
    const toggle = document.getElementById("togglePassword");
    if (toggle) {
      toggle.addEventListener("click", () => {
        const type = pwdInput.type === "password" ? "text" : "password";
        pwdInput.type = type;
        toggle.textContent = type === "password" ? "👁️" : "🙈";
      });
    }
  </script>
</body>
</html>
