<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <div class="auth-layout" style="display:grid; grid-template-columns:1.2fr 1fr; gap:32px; max-width:940px; margin:32px auto; align-items:center;">
      <div class="card-glass">
        <h1 style="font-size:28px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
          Welcome Back
        </h1>
        <p class="meta" style="font-size:15px; color:var(--neutral-500); margin:0 0 20px;">
          Sign in to access your AI meal logger, diet plans, and clinical roster.
        </p>

        <!-- Quick 1-Click Role Login for Interviewers / Demo -->
        <div style="background:#f8fafc; border:1px solid var(--neutral-200); border-radius:16px; padding:14px; margin-bottom:20px;">
          <div style="font-size:12px; font-weight:800; color:var(--neutral-500); text-transform:uppercase; margin-bottom:8px;">
            ⚡ 1-Click Demo Accounts (Instant Role Access):
          </div>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button type="button" class="btn-sm-action btn-eaten" onclick="fillDemo('admin@balancedbowl.com', 'admin')">
              👑 Admin
            </button>
            <button type="button" class="btn-sm-action btn-swap" onclick="fillDemo('sarah@balancedbowl.com', 'sarah')">
              🩺 Dietician (Dr. Sarah)
            </button>
            <button type="button" class="btn-sm-action btn-skip" style="color:#0284c7; border-color:#bae6fd;" onclick="fillDemo('sweatha@balancedbowl.com', 'user123')">
              🥗 User (Sweatha)
            </button>
          </div>
        </div>

        <form action="/login" method="post" style="display:grid; gap:16px;">
          <div class="field">
            <label style="font-weight:700; font-size:13px;">Email Address</label>
            <input type="email" name="email" id="loginEmail" class="field-input" placeholder="e.g. sweatha@balancedbowl.com" required>
          </div>

          <div class="field">
            <label style="font-weight:700; font-size:13px;">Password</label>
            <div style="position:relative;">
              <input type="password" id="password" name="password" class="field-input" placeholder="Enter your password" required style="width:100%; padding-right:42px;">
              <span id="togglePassword" style="position:absolute; right:14px; top:50%; transform:translateY(-50%); cursor:pointer;">👁️</span>
            </div>
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
            <button class="btn-ai" type="submit" style="padding:14px 28px;">
              Sign In to Account
            </button>
            <a href="/register" style="font-size:14px; color:var(--primary-emerald-dark); font-weight:700; text-decoration:none;">
              Create account →
            </a>
          </div>
        </form>
      </div>

      <div class="card-glass" style="text-align:center; padding:32px;">
        <div style="width:100%; border-radius:20px; overflow:hidden; margin-bottom:18px;">
          <img src="https://images.unsplash.com/photo-1556228720-f0b6e5a4f2a4?w=600&q=60&auto=format&fit=crop" alt="Progress tracking" style="width:100%; height:auto; display:block;">
        </div>
        <h3 style="margin:0 0 6px; font-size:18px; font-weight:700;">Clinical & AI Innovation</h3>
        <p class="meta" style="font-size:14px; color:var(--neutral-500); margin:0;">
          Closed-loop tracking between dieticians and clients with intelligent pantry substitution and NLP food parsing.
        </p>
      </div>
    </div>

    <%- include('partials/footer') %>
  </div>

<script>
function fillDemo(email, pwd) {
  document.getElementById('loginEmail').value = email;
  document.getElementById('password').value = pwd;
}

const pwdInput = document.getElementById("password");
const toggle = document.getElementById("togglePassword");
if (toggle) {
  toggle.addEventListener("click", () => {
    const type = pwdInput.type === "password" ? "text" : "password";
    pwdInput.type = type;
    toggle.textContent = type === "password" ? "👁️" : "🙈";
  });
}
</script>

</body>
</html>
