<!doctype html>
<html>
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <div class="form-card" style="max-width:900px;margin:0 auto;">
      <div class="page-heading">
        <div>
          <h2>Book appointment with <strong><%= dietician.user.name %></strong></h2>
          <p class="meta">Fee: ₹<%= dietician.fee %> • Experience: <%= dietician.experienceYears %> yrs</p>
        </div>
        <a href="/dieticians/<%= dietician._id %>" class="btn btn-secondary">View Profile</a>
      </div>

      <form action="/appointments/create" method="post" class="split-grid form-panel">
        <input type="hidden" name="dieticianId" value="<%= dietician._id %>">

        <div>
          <div class="field">
            <label>Select date</label>
            <input type="date" name="date" required>
          </div>

          <div class="field">
            <label>Notes (optional)</label>
            <textarea name="notes" rows="4"></textarea>
          </div>
        </div>

        <div>
          <div class="field">
            <label>Time</label>
            <select name="time">
              <option>09:00 AM</option>
              <option>11:00 AM</option>
              <option>02:00 PM</option>
              <option>05:00 PM</option>
            </select>
          </div>

          <div class="field">
            <label>Mode</label>
            <select name="mode">
              <% dietician.consultationModes.forEach(m => { %>
                <option value="<%= m %>"><%= m %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-actions">
            <button class="button" style="width:100%;">Proceed to Payment</button>
          </div>
        </div>
      </form>
    </div>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
