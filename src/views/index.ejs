<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <!-- Hero Section -->
    <section class="hero" style="padding:40px 0;">
      <div class="hero-copy">
        <span class="badge-pill badge-success" style="margin-bottom:12px;">
          🥗 Clinical & AI-Powered Nutrition
        </span>
        <h1 style="font-size:clamp(36px, 4.5vw, 52px); font-weight:800; line-height:1.1; color:var(--neutral-900); margin:0 0 16px;">
          Eat Intelligently.<br>Live Powerfully.
        </h1>
        <p style="font-size:16px; color:var(--neutral-500); line-height:1.5; margin:0 0 24px;">
          Certified dieticians, conversational AI food plate logging, dynamic macro-matched pantry swaps, and automated clinical adherence monitoring.
        </p>

        <div class="hero-actions" style="display:flex; gap:12px; flex-wrap:wrap;">
          <% if (!currentUser) { %>
            <a href="/register" class="btn-ai" style="padding:14px 26px; text-decoration:none;">
              🚀 Start Your Health Journey
            </a>
            <a href="/dieticians" class="btn btn-secondary" style="padding:14px 22px;">
              Find Dieticians
            </a>
          <% } else if (currentUser.role === 'dietician') { %>
            <a href="/appointments/clients" class="btn-ai" style="padding:14px 26px; text-decoration:none;">
              🩺 Clinical Client Roster →
            </a>
          <% } else if (currentUser.role === 'admin') { %>
            <a href="/admin" class="btn-ai" style="padding:14px 26px; text-decoration:none; background:#0f172a;">
              ⚡ Admin Command Center →
            </a>
          <% } else { %>
            <a href="/dashboard" class="btn-ai" style="padding:14px 26px; text-decoration:none;">
              📊 Open Health Dashboard →
            </a>
            <a href="/user/diet-plan" class="btn btn-secondary" style="padding:14px 22px;">
              My Diet Plan
            </a>
          <% } %>
        </div>

        <!-- Metric highlights -->
        <div style="display:flex; gap:20px; margin-top:28px; border-top:1px solid var(--neutral-200); padding-top:16px; flex-wrap:wrap;">
          <div>
            <strong style="font-size:20px; color:var(--neutral-900); font-weight:800;">100%</strong>
            <div style="font-size:12px; color:var(--neutral-500);">Verified Clinicians</div>
          </div>
          <div>
            <strong style="font-size:20px; color:var(--primary-emerald-dark); font-weight:800;">±10%</strong>
            <div style="font-size:12px; color:var(--neutral-500);">Macro Equivalence</div>
          </div>
          <div>
            <strong style="font-size:20px; color:#0284c7; font-weight:800;">Real-time</strong>
            <div style="font-size:12px; color:var(--neutral-500);">Plateau Alerts</div>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div style="position:relative; width:100%; border-radius:28px; overflow:hidden; box-shadow:0 24px 50px rgba(16,185,129,0.16);">
          <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=900&q=80&auto=format&fit=crop" alt="Healthy balanced bowl" style="width:100%; height:100%; display:block; object-fit:cover;">
          
          <!-- Floating interactive badge -->
          <div style="position:absolute; bottom:16px; left:16px; right:16px; background:rgba(255,255,255,0.96); backdrop-filter:blur(10px); border-radius:18px; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; box-shadow:0 10px 24px rgba(0,0,0,0.1);">
            <div style="display:flex; align-items:center; gap:10px;">
              <span style="font-size:24px;">🥗</span>
              <div>
                <strong style="font-size:14px; color:var(--neutral-900); display:block;">Smart Food Plate AI</strong>
                <span style="font-size:12px; color:var(--primary-emerald-dark); font-weight:700;">280 kcal • 18g Protein (A+ Grade)</span>
              </div>
            </div>
            <span class="badge-pill badge-success" style="font-size:11px;">Active</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 Golden Features Architecture Showcase -->
    <section class="section" style="margin:40px 0;">
      <div style="text-align:center; max-width:640px; margin:0 auto 30px;">
        <span class="badge-pill badge-purple" style="margin-bottom:8px;">INNOVATION HIGHLIGHTS</span>
        <h2 style="font-size:28px; font-weight:800; color:var(--neutral-900); margin:0 0 8px;">
          The 3 Pillars of The Balanced Bowl
        </h2>
        <p style="font-size:14px; color:var(--neutral-500); margin:0;">
          Eliminating friction in nutrition: automated macro logging, flexible recipe swaps, and closed-loop adherence.
        </p>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px;">
        
        <!-- Pillar 1 -->
        <div class="card-glass" style="border-top:4px solid var(--primary-emerald); padding:24px;">
          <div style="font-size:28px; margin-bottom:10px;">🎙️</div>
          <h3 style="font-size:18px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
            1. AI Natural Language Macro Logger
          </h3>
          <p style="font-size:14px; color:var(--neutral-700); line-height:1.5; margin:0 0 14px;">
            Type meals naturally in plain English. The NLP engine parses ingredients, calculates macros (calories, protein, carbs, fats), and grades your plate.
          </p>
          <span class="badge-pill badge-info" style="font-size:11px;">Zero Manual Entry</span>
        </div>

        <!-- Pillar 2 -->
        <div class="card-glass" style="border-top:4px solid #f59e0b; padding:24px;">
          <div style="font-size:28px; margin-bottom:10px;">🔄</div>
          <h3 style="font-size:18px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
            2. Smart Pantry Swapper & Grocery List
          </h3>
          <p style="font-size:14px; color:var(--neutral-700); line-height:1.5; margin:0 0 14px;">
            Missing ingredients? 1-Click "Swap Meal" finds macro-equivalent alternatives within ±10% calories. Consolidates a 7-day grocery list by supermarket aisle.
          </p>
          <span class="badge-pill badge-warning" style="font-size:11px;">Zero Diet Abandonment</span>
        </div>

        <!-- Pillar 3 -->
        <div class="card-glass" style="border-top:4px solid #0284c7; padding:24px;">
          <div style="font-size:28px; margin-bottom:10px;">📊</div>
          <h3 style="font-size:18px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
            3. Adherence & Metabolic Plateau Alerts
          </h3>
          <p style="font-size:14px; color:var(--neutral-700); line-height:1.5; margin:0 0 14px;">
            Daily check-ins compute a 7-day compliance score. The engine flags metabolic plateaus (>80% adherence with static weight) for proactive dietician adjustments.
          </p>
          <span class="badge-pill badge-success" style="font-size:11px;">Clinical Provider Loop</span>
        </div>
      </div>
    </section>

    <!-- Community Transformations -->
    <% if (stories && stories.length > 0) { %>
      <section class="section" style="margin-bottom:40px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
          <div>
            <h2 style="font-size:22px; font-weight:800; color:var(--neutral-900); margin:0;">
              ⭐ Patient Transformations
            </h2>
            <span class="meta" style="font-size:13px; color:var(--neutral-500);">Real patient results achieved with our dieticians</span>
          </div>
          <a href="/share-story" class="btn btn-secondary" style="font-size:13px; padding:6px 14px;">+ Share Your Story</a>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:18px;">
          <% stories.slice(0, 3).forEach(function(s) { %>
            <div class="card-glass" style="padding:18px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <strong style="font-size:15px; color:var(--neutral-900);"><%= s.name %></strong>
                <% if (s.beforeWeight && s.afterWeight) { %>
                  <span class="badge-pill badge-success" style="font-size:11px;">
                    -<%= (s.beforeWeight - s.afterWeight).toFixed(1) %> kg in <%= s.duration || '3 mo' %>
                  </span>
                <% } %>
              </div>
              <p style="font-size:13px; color:var(--neutral-700); line-height:1.5; margin:0;">
                "<%= s.story %>"
              </p>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
