<!doctype html>
<html>
  <%- include('../partials/head') %>
<body>
  <div class="container">
    <%- include('../partials/header') %>

    <div style="max-width:1100px; margin:20px auto;">
      <h2>Admin Reports</h2>

      <div class="grid">
        <div class="card">
          <h3>Total users</h3>
          <div style="font-size:22px; font-weight:700;"><%= summary.users || 0 %></div>
        </div>
        <div class="card">
          <h3>Total dieticians</h3>
          <div style="font-size:22px; font-weight:700;"><%= summary.dieticians || 0 %></div>
        </div>
        <div class="card">
          <h3>Appointments</h3>
          <div style="font-size:22px; font-weight:700;"><%= summary.appointments || 0 %></div>
        </div>
      </div>

      <div class="card" style="margin-top:12px;">
        <h3>Recent activity</h3>
        <ul>
          <% (activity || []).forEach(item => { %>
            <li><%= item %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <%- include('../partials/footer') %>
  </div>
</body>
</html>
