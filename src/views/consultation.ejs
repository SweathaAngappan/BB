<!doctype html>
<html>
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <section class="section">
      <div class="section-header">
        <div>
          <h1 class="section-title">Online Consultation</h1>
          <p class="section-subtitle">Video session with your dietician. Use this placeholder for demo.</p>
        </div>
      </div>

      <div style="display:grid; grid-template-columns: 1fr 320px; gap:18px;">
        <div class="card" style="min-height:420px; display:flex; flex-direction:column;">
          <div style="flex:1; background:#000; border-radius:12px; overflow:hidden; display:flex; align-items:center; justify-content:center; color:#fff;">Video placeholder</div>
          <div style="display:flex; gap:8px; margin-top:12px; justify-content:center">
            <button class="btn">Mute</button>
            <button class="btn">Camera</button>
            <button class="btn btn-secondary">End Call</button>
          </div>
        </div>

        <div class="card">
          <h3 style="margin-top:0">Chat</h3>
          <div style="height:340px; overflow:auto; border-radius:8px; padding:8px; background:#fbfdfb; border:1px solid rgba(54,165,108,0.06);">
            <div style="margin-bottom:8px;"><strong>Dr. Smith</strong><div class="meta">Hello! How can I help you today?</div></div>
            <div style="text-align:right;"><strong>You</strong><div class="meta">I have been tracking my weight...</div></div>
          </div>

          <form style="margin-top:12px; display:flex; gap:8px;">
            <input type="text" placeholder="Type a message" style="flex:1; padding:10px; border-radius:8px; border:1px solid var(--border);">
            <button class="btn btn-accent">Send</button>
          </form>
        </div>
      </div>
    </section>

    <%- include('partials/footer') %>
  </div>
</body>
</html>