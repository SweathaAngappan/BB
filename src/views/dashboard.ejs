<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <!-- Welcome & Quick Action Header -->
    <section class="section" style="margin-bottom: 20px;">
      <div class="page-heading" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
        <div>
          <h1 style="font-size:30px; font-weight:800; color:var(--neutral-900); margin:0;">
            Hi, <%= user ? user.name.split(' ')[0] : 'there' %> 👋
          </h1>
          <p class="meta" style="font-size:15px; color:var(--neutral-500); margin:4px 0 0;">
            <%= currentDayName %>'s Health & Nutrition Dashboard
          </p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a class="button" href="/user/diet-plan" style="display:inline-flex; align-items:center; gap:6px;">
            🥗 7-Day Plan
          </a>
          <a class="btn btn-secondary" href="/user/grocery-list" style="display:inline-flex; align-items:center; gap:6px;">
            🛒 Grocery List
          </a>
        </div>
      </div>
    </section>

    <!-- Feature 3: Clinical Adherence & Metabolic Status Ribbon -->
    <% if (clinicalStatus) { %>
      <div class="card-glass" style="margin-bottom:24px; padding:18px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; border-left:6px solid <%= clinicalStatus.status === 'plateau_warning' ? '#f59e0b' : (clinicalStatus.status === 'at_risk' ? '#f43f5e' : '#10b981') %>;">
        <div style="display:flex; align-items:center; gap:16px;">
          <div class="health-grade-pill <%= clinicalStatus.status === 'plateau_warning' ? 'grade-B' : (clinicalStatus.status === 'at_risk' ? 'grade-C' : 'grade-A') %>">
            <%= adherenceScore %>%
          </div>
          <div>
            <div style="display:flex; align-items:center; gap:10px;">
              <strong style="font-size:16px; color:var(--neutral-900);">7-Day Adherence Index</strong>
              <span class="badge-pill <%= clinicalStatus.badgeClass %>"><%= clinicalStatus.label %></span>
            </div>
            <p style="margin:2px 0 0; font-size:13px; color:var(--neutral-700);"><%= clinicalStatus.clinicalAlert %></p>
          </div>
        </div>
        <div style="text-align:right;">
          <div style="font-size:12px; color:var(--neutral-500); text-transform:uppercase; font-weight:700;">Remaining Today</div>
          <strong style="font-size:20px; color:var(--primary-emerald-dark);"><%= consumed.remainingCalories %> kcal</strong>
        </div>
      </div>
    <% } %>

    <!-- Feature 1: AI Natural Language Food Plate Logger -->
    <section class="section" style="margin-bottom: 28px;">
      <div class="ai-logger-box" id="aiFoodLogger">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
          <div>
            <h2 style="font-size:20px; font-weight:800; color:var(--neutral-900); margin:0 0 2px;">
              🎙️ AI Food Plate Logger
            </h2>
            <p style="margin:0; font-size:13px; color:var(--neutral-500);">
              Log meals in natural words. Auto-calculates calories, protein, carbs, and fats.
            </p>
          </div>
        </div>

        <form action="/user/ai-food-log" method="post" id="aiFoodForm" style="margin-top:14px;">
          <div class="ai-input-row">
            <input 
              type="text" 
              name="mealText" 
              id="aiFoodInput" 
              class="ai-input" 
              placeholder="e.g. 2 rotis with 1 bowl dal tadka and cucumber salad"
              required
              autocomplete="off"
            />
            <select name="mealType" id="aiMealType" class="field-input" style="width:140px; border-radius:18px; border:2px solid rgba(16,185,129,0.2); font-weight:600;">
              <option value="Breakfast">Breakfast</option>
              <option value="Morning Snack">Snack</option>
              <option value="Lunch" selected>Lunch</option>
              <option value="Dinner">Dinner</option>
            </select>
            <button type="submit" id="btnLogMeal" class="btn-ai">
              <span>✨ Parse & Log</span>
            </button>
          </div>
        </form>

        <!-- Quick AI Prompt Chips -->
        <div style="display:flex; align-items:center; gap:8px; margin-top:12px; flex-wrap:wrap;">
          <span style="font-size:11px; font-weight:700; color:var(--neutral-500); text-transform:uppercase;">Quick try:</span>
          <button type="button" class="btn-sm-action" style="background:#fff; border:1px solid #d1d5db; font-size:12px; padding:4px 10px;" onclick="setAiPrompt('2 rotis with 1 bowl dal tadka and cucumber salad')">
            2 rotis + dal + salad
          </button>
          <button type="button" class="btn-sm-action" style="background:#fff; border:1px solid #d1d5db; font-size:12px; padding:4px 10px;" onclick="setAiPrompt('Greek yogurt bowl with 1 banana, chia seeds and almonds')">
            Greek yogurt + almonds
          </button>
          <button type="button" class="btn-sm-action" style="background:#fff; border:1px solid #d1d5db; font-size:12px; padding:4px 10px;" onclick="setAiPrompt('Grilled chicken breast with 1 cup brown rice and broccoli')">
            Grilled chicken + rice
          </button>
          <button type="button" class="btn-sm-action" style="background:#fff; border:1px solid #d1d5db; font-size:12px; padding:4px 10px;" onclick="setAiPrompt('Moong dal chilla with mint chutney and buttermilk')">
            Moong dal chilla
          </button>
        </div>
      </div>
    </section>

    <!-- Daily Macro Breakdown & Hydration Progress (2 Columns) -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:20px; margin-bottom:28px;">
      
      <!-- Macro Nutritional Budget -->
      <div class="card-glass">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
          <div>
            <h3 style="margin:0; font-size:17px; font-weight:700;">Macronutrient Budget</h3>
            <span class="meta" style="font-size:12px;">Prescribed Daily Limits</span>
          </div>
          <span class="badge-pill badge-info"><%= consumed.calories %> / <%= targets.calories %> kcal</span>
        </div>

        <!-- Calories Bar -->
        <div style="margin-bottom:14px;">
          <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:700; margin-bottom:4px;">
            <span>Calories</span>
            <span><%= Math.round((consumed.calories / targets.calories) * 100) %>%</span>
          </div>
          <div style="height:8px; background:#e2e8f0; border-radius:9999px; overflow:hidden;">
            <div style="height:100%; width:<%= Math.min(100, Math.round((consumed.calories / targets.calories) * 100)) %>%; background:var(--primary-emerald); border-radius:9999px;"></div>
          </div>
        </div>

        <!-- Protein Bar -->
        <div style="margin-bottom:14px;">
          <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:700; margin-bottom:4px;">
            <span style="color:#166534;">Protein: <%= consumed.protein %>g / <%= targets.protein %>g</span>
            <span><%= Math.round((consumed.protein / targets.protein) * 100) %>%</span>
          </div>
          <div style="height:7px; background:#e2e8f0; border-radius:9999px; overflow:hidden;">
            <div style="height:100%; width:<%= Math.min(100, Math.round((consumed.protein / targets.protein) * 100)) %>%; background:#10b981; border-radius:9999px;"></div>
          </div>
        </div>

        <!-- Carbs Bar -->
        <div style="margin-bottom:14px;">
          <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:700; margin-bottom:4px;">
            <span style="color:#b45309;">Carbs: <%= consumed.carbs %>g / <%= targets.carbs %>g</span>
            <span><%= Math.round((consumed.carbs / targets.carbs) * 100) %>%</span>
          </div>
          <div style="height:7px; background:#e2e8f0; border-radius:9999px; overflow:hidden;">
            <div style="height:100%; width:<%= Math.min(100, Math.round((consumed.carbs / targets.carbs) * 100)) %>%; background:#f59e0b; border-radius:9999px;"></div>
          </div>
        </div>

        <!-- Fats Bar -->
        <div>
          <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:700; margin-bottom:4px;">
            <span style="color:#9f1239;">Fats: <%= consumed.fats %>g / <%= targets.fats %>g</span>
            <span><%= Math.round((consumed.fats / targets.fats) * 100) %>%</span>
          </div>
          <div style="height:7px; background:#e2e8f0; border-radius:9999px; overflow:hidden;">
            <div style="height:100%; width:<%= Math.min(100, Math.round((consumed.fats / targets.fats) * 100)) %>%; background:#f43f5e; border-radius:9999px;"></div>
          </div>
        </div>
      </div>

      <!-- Hydration Ring & Quick Entry -->
      <div class="card-glass">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
          <div>
            <h3 style="margin:0; font-size:17px; font-weight:700;">Hydration Tracker</h3>
            <span class="meta" style="font-size:12px;">Target: 2,500 ml</span>
          </div>
          <span class="badge-pill badge-info" id="waterIntakeDisplay">2,200 / 2,500 ml</span>
        </div>

        <div style="display:flex; align-items:center; justify-content:center; gap:20px; padding:10px 0;">
          <div id="waterRingContainer" style="width:130px; height:130px; position:relative; display:flex; align-items:center; justify-content:center;">
            <svg viewBox="0 0 36 36" style="width:100%; height:100%; transform: rotate(-90deg);">
              <path stroke="#e2e8f0" stroke-width="3.5" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path stroke="#0284c7" stroke-dasharray="88, 100" stroke-width="3.5" stroke-linecap="round" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            </svg>
            <div style="position:absolute; text-align:center;">
              <span style="font-size:22px; font-weight:800; color:#0284c7;">88%</span>
              <div style="font-size:10px; font-weight:700; color:var(--neutral-500);">HYDRATED</div>
            </div>
          </div>

          <div style="display:grid; gap:8px;">
            <button type="button" class="btn-sm-action" style="background:#f0f9ff; color:#0369a1; border:1px solid #bae6fd; padding:8px 14px;" onclick="addWater(250)">
              💧 +250 ml (Glass)
            </button>
            <button type="button" class="btn-sm-action" style="background:#f0f9ff; color:#0369a1; border:1px solid #bae6fd; padding:8px 14px;" onclick="addWater(500)">
              🥤 +500 ml (Bottle)
            </button>
            <a href="/user/log" class="button" style="padding:6px 12px; font-size:12px; text-align:center;">+ Vitals Log</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 3: Today's Scheduled Meals Checklist & 1-Click Swap -->
    <section class="section" style="margin-bottom: 28px;">
      <div class="section-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
        <div>
          <h2 class="section-title" style="margin:0; font-size:20px; font-weight:800;">
            📅 Today's Meals (<%= currentDayName %>)
          </h2>
        </div>
        <a href="/user/diet-plan" class="btn btn-secondary" style="font-size:13px; padding:6px 14px;">7-Day Calendar</a>
      </div>

      <div style="display:grid; gap:12px;">
        <% if (!todaysPrescribedMeals || todaysPrescribedMeals.length === 0) { %>
          <div class="card-glass" style="text-align:center; padding:24px; color:var(--neutral-500); font-size:14px;">
            No specific meals prescribed for today yet. Use the AI food logger above to log whatever you eat!
          </div>
        <% } else { %>
          <% todaysPrescribedMeals.forEach(function(meal) { %>
            <div class="meal-check-card" id="meal-card-<%= meal._id %>">
              <div style="display:flex; align-items:center; gap:14px;">
                <div style="width:40px; height:40px; border-radius:12px; background:var(--primary-emerald-light); color:var(--primary-emerald-dark); display:flex; align-items:center; justify-content:center; font-size:18px;">
                  <% if (meal.mealType === 'Breakfast') { %>🍳<% } else if (meal.mealType === 'Lunch') { %>🥗<% } else if (meal.mealType === 'Dinner') { %>🍲<% } else { %>🍎<% } %>
                </div>
                <div>
                  <div style="display:flex; align-items:center; gap:8px;">
                    <span class="badge-pill badge-info" style="font-size:11px; padding:2px 8px;"><%= meal.mealType %></span>
                    <strong style="font-size:15px; color:var(--neutral-900);"><%= meal.item %></strong>
                  </div>
                  <div class="macro-group" style="margin-top:4px;">
                    <span class="macro-chip calories" style="font-size:11px; padding:2px 6px;">⚡ <%= meal.calories %> kcal</span>
                    <% if (meal.protein) { %><span class="macro-chip protein" style="font-size:11px; padding:2px 6px;">🥩 <%= meal.protein %>g P</span><% } %>
                    <% if (meal.carbs) { %><span class="macro-chip carbs" style="font-size:11px; padding:2px 6px;">🌾 <%= meal.carbs %>g C</span><% } %>
                  </div>
                </div>
              </div>

              <!-- Action buttons -->
              <div class="meal-action-btns">
                <button type="button" class="btn-sm-action btn-eaten" onclick="recordCompliance('<%= meal._id %>', 'eaten', '<%= meal.item %>', <%= meal.calories %>)">
                  ✅ Eaten
                </button>
                <button type="button" class="btn-sm-action btn-swap" onclick="openSwapModal('<%= meal._id %>', '<%= meal.item %>', <%= meal.calories %>, '<%= meal.mealType %>')">
                  🔄 Swap
                </button>
                <button type="button" class="btn-sm-action btn-skip" onclick="recordCompliance('<%= meal._id %>', 'skipped', '<%= meal.item %>', 0)">
                  Skip
                </button>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </section>

    <!-- Weight Trend SVG Chart & Consultations Grid -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:20px; margin-bottom:28px;">
      
      <!-- Weight Trend Chart -->
      <div class="card-glass">
        <div class="section-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
          <div>
            <h3 style="margin:0; font-size:16px; font-weight:700;">Weight Trajectory</h3>
            <span class="meta" style="font-size:12px;">Recent Weigh-ins</span>
          </div>
          <a href="/user/log" class="button" style="padding:6px 12px; font-size:12px;">+ Log Weight</a>
        </div>
        <div id="weightChart" style="min-height:160px; display:flex; align-items:center; justify-content:center; color:var(--neutral-500); font-size:13px;"></div>
      </div>

      <!-- Upcoming Consultations -->
      <div class="card-glass">
        <div class="section-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
          <div>
            <h3 style="margin:0; font-size:16px; font-weight:700;">Consultations</h3>
            <span class="meta" style="font-size:12px;">Clinical Sessions</span>
          </div>
          <a href="/dieticians" class="btn btn-secondary" style="font-size:12px; padding:6px 12px;">Find Dietician</a>
        </div>

        <div style="display:grid; gap:10px;">
          <% if (!appts || appts.length === 0) { %>
            <div style="color:var(--neutral-500); font-size:13px; padding:20px 0; text-align:center;">
              No consultations booked yet.
            </div>
          <% } else { %>
            <% appts.slice(0, 2).forEach(function(a) { %>
              <div style="background:#f8fafc; border:1px solid var(--neutral-200); border-radius:14px; padding:12px 14px; display:flex; justify-content:space-between; align-items:center;">
                <div>
                  <strong style="font-size:14px; color:var(--neutral-900);"><%= a.dietician?.user?.name || 'Dietician' %></strong>
                  <div style="font-size:12px; color:var(--neutral-500);"><%= new Date(a.date).toLocaleDateString() %> • <%= a.mode.toUpperCase() %></div>
                </div>
                <% if (a.meetingLink && a.status === 'booked') { %>
                  <a href="<%= a.meetingLink %>" target="_blank" class="button" style="background:#0284c7; color:#fff; font-size:12px; padding:6px 12px; text-decoration:none;">
                    📹 Join Call
                  </a>
                <% } else { %>
                  <span class="badge-pill <%= a.status === 'completed' ? 'badge-success' : 'badge-info' %>" style="font-size:11px; padding:2px 8px;">
                    <%= a.status %>
                  </span>
                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

    </div>

    <%- include('partials/footer') %>
  </div>

  <!-- Feature 2: 1-Click Smart Meal Swap Modal -->
  <div class="modal-overlay" id="swapModalOverlay">
    <div class="modal-dialog-box" style="padding:24px; max-width:540px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h3 style="margin:0; font-size:18px; font-weight:800; color:var(--neutral-900);">
          🔄 Smart Pantry Meal Swap
        </h3>
        <button type="button" style="background:none; border:none; font-size:22px; cursor:pointer;" onclick="closeSwapModal()">✕</button>
      </div>

      <p style="margin:0 0 14px; font-size:13px; color:var(--neutral-500);">
        Replacing: <strong id="swapOriginalItem" style="color:var(--neutral-900);"></strong> (<span id="swapOriginalCalories"></span> kcal).
        Select an alternative maintaining your caloric and protein targets:
      </p>

      <div id="substitutesContainer" style="display:grid; gap:10px;"></div>
    </div>
  </div>

  <script>
    function setAiPrompt(text) {
      const input = document.getElementById('aiFoodInput');
      if (input) {
        input.value = text;
        input.focus();
      }
    }

    async function recordCompliance(mealId, status, foodName, calories) {
      try {
        const res = await fetch('/user/meal-compliance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ planMealId: mealId, status, foodName, calories })
        });
        const data = await res.json();
        if (data.success) {
          const card = document.getElementById('meal-card-' + mealId);
          if (card) {
            card.className = 'meal-check-card status-' + status;
            card.querySelector('.meal-action-btns').innerHTML = '<span class="badge-pill badge-success" style="font-size:11px;">' + status.toUpperCase() + '</span>';
          }
        }
      } catch (err) {
        console.error('Compliance error:', err);
      }
    }

    async function openSwapModal(mealId, item, calories, mealType) {
      const overlay = document.getElementById('swapModalOverlay');
      document.getElementById('swapOriginalItem').textContent = item;
      document.getElementById('swapOriginalCalories').textContent = calories;
      overlay.classList.add('active');

      const container = document.getElementById('substitutesContainer');
      container.innerHTML = '<div style="text-align:center; padding:16px; font-size:13px; color:var(--neutral-500);">Finding macro-equivalent options...</div>';

      try {
        const res = await fetch(`/user/substitutes?item=${encodeURIComponent(item)}&calories=${calories}&mealType=${encodeURIComponent(mealType)}`);
        const data = await res.json();

        if (data.success && data.substitutes.length > 0) {
          container.innerHTML = data.substitutes.map(sub => `
            <div class="card-glass" style="padding:14px; border:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; gap:12px;">
              <div>
                <strong style="font-size:14px; color:var(--neutral-900);">${sub.item}</strong>
                <div style="font-size:12px; color:var(--neutral-500); margin-top:2px;">${sub.portion}</div>
                <div class="macro-group" style="margin-top:6px;">
                  <span class="macro-chip calories" style="font-size:11px; padding:2px 6px;">${sub.calories} kcal (${sub.calorieDiff >= 0 ? '+' : ''}${sub.calorieDiff})</span>
                  <span class="macro-chip protein" style="font-size:11px; padding:2px 6px;">${sub.protein}g Protein</span>
                </div>
              </div>
              <form action="/user/swap-meal" method="post" style="margin:0;">
                <input type="hidden" name="mealId" value="${mealId}">
                <input type="hidden" name="newItem" value="${sub.item}">
                <input type="hidden" name="newPortion" value="${sub.portion}">
                <input type="hidden" name="newCalories" value="${sub.calories}">
                <input type="hidden" name="newProtein" value="${sub.protein}">
                <input type="hidden" name="newCarbs" value="${sub.carbs}">
                <input type="hidden" name="newFats" value="${sub.fats}">
                <button type="submit" class="button" style="padding:6px 14px; font-size:12px;">Swap In</button>
              </form>
            </div>
          `).join('');
        } else {
          container.innerHTML = '<div style="text-align:center; padding:14px; font-size:13px;">No substitutes found.</div>';
        }
      } catch (err) {
        container.innerHTML = '<div style="color:red; text-align:center; font-size:13px;">Failed to load substitutes.</div>';
      }
    }

    function closeSwapModal() {
      document.getElementById('swapModalOverlay').classList.remove('active');
    }

    function addWater(amount) {
      fetch('/user/log', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ weight: <%= user ? user.weight : 65 %>, waterIntakeMl: 2200 + amount, mood: 'Refreshed' })
      }).then(() => location.reload());
    }

    fetch('/user/progress')
      .then(r => r.json())
      .then(res => {
        if (res.success && res.data.length > 0) {
          renderWeightChart(res.data);
        }
      });

    function renderWeightChart(logs) {
      const container = document.getElementById('weightChart');
      if (!logs || logs.length === 0) return;

      const values = logs.map(l => Number(l.weight) || 0);
      const min = Math.min(...values);
      const max = Math.max(...values);
      const range = Math.max(max - min, 1);
      const width = 480;
      const height = 150;
      const pad = 18;

      const points = values.map((val, idx) => {
        const x = pad + (idx / Math.max(values.length - 1, 1)) * (width - 2 * pad);
        const y = height - pad - ((val - min) / range) * (height - 2 * pad);
        return `${x},${y}`;
      }).join(' ');

      container.innerHTML = `
        <svg viewBox="0 0 ${width} ${height}" style="width:100%; height:auto;">
          <polyline fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" points="${points}" />
          ${values.map((val, idx) => {
            const x = pad + (idx / Math.max(values.length - 1, 1)) * (width - 2 * pad);
            const y = height - pad - ((val - min) / range) * (height - 2 * pad);
            return `<circle cx="${x}" cy="${y}" r="3.5" fill="#059669" stroke="#fff" stroke-width="1.5" />`;
          }).join('')}
        </svg>
      `;
    }
  </script>
</body>
</html>
