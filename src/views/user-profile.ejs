<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
  <%
    var bmi = (typeof bmi !== 'undefined') ? bmi : null;
    var status = (typeof status !== 'undefined') ? status : null;
    var bmr = (typeof bmr !== 'undefined') ? bmr : 1750;
    var user = (typeof user !== 'undefined' && user) ? user : {};
  %>
<body>
  <div class="container">
    <%- include('partials/header') %>

    <section class="section" style="margin-bottom: 24px;">
      <div class="page-heading" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px;">
        <div>
          <h1 style="font-size:32px; font-weight:800; color:var(--neutral-900); margin:0 0 6px;">
            👤 Patient Profile & Vital Metrics
          </h1>
          <p class="meta" style="font-size:16px; color:var(--neutral-500); margin:0;">
            Comprehensive clinical metrics, physiological targets, and dietary parameters.
          </p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a class="button" href="/user/edit-health">✏️ Edit Health & Allergies</a>
          <a class="btn btn-secondary" href="/dashboard">Go to Dashboard</a>
        </div>
      </div>
    </section>

    <!-- Profile Header Card -->
    <div class="card-glass" style="margin-bottom:28px;">
      <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
        <div style="width:72px; height:72px; border-radius:22px; background:linear-gradient(135deg, #10b981, #059669); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:26px; box-shadow:0 12px 24px rgba(16,185,129,0.3);">
          <%= user.name ? user.name.split(' ').map(n => n[0]).slice(0,2).join('') : 'U' %>
        </div>
        <div>
          <h2 style="font-size:24px; font-weight:800; color:var(--neutral-900); margin:0 0 4px;"><%= user.name %></h2>
          <div style="font-size:14px; color:var(--neutral-500);"><%= user.email %> • <%= user.phone || 'No phone set' %></div>
          <div style="display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;">
            <span class="badge-pill badge-info"><%= user.role.toUpperCase() %></span>
            <span class="badge-pill badge-purple"><%= user.dietaryPreference || 'Flexible' %></span>
            <span class="badge-pill badge-success"><%= bmi ? bmi + ' BMI' : 'BMI Pending' %></span>
          </div>
        </div>
      </div>

      <!-- Demographics & Metrics Grid -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:18px; margin-top:24px; padding-top:20px; border-top:1px solid var(--neutral-100);">
        <div>
          <div style="font-size:12px; font-weight:700; color:var(--neutral-500); text-transform:uppercase;">Height</div>
          <strong style="font-size:18px; color:var(--neutral-900);"><%= user.height ? user.height + ' cm' : '—' %></strong>
        </div>
        <div>
          <div style="font-size:12px; font-weight:700; color:var(--neutral-500); text-transform:uppercase;">Current Weight</div>
          <strong style="font-size:18px; color:var(--neutral-900);"><%= user.weight ? user.weight + ' kg' : '—' %></strong>
        </div>
        <div>
          <div style="font-size:12px; font-weight:700; color:var(--neutral-500); text-transform:uppercase;">Target Weight</div>
          <strong style="font-size:18px; color:var(--primary-emerald-dark);"><%= user.targetWeight ? user.targetWeight + ' kg' : 'Maintenance' %></strong>
        </div>
        <div>
          <div style="font-size:12px; font-weight:700; color:var(--neutral-500); text-transform:uppercase;">Basal Metabolic Rate (BMR)</div>
          <strong style="font-size:18px; color:#0284c7;">~<%= bmr %> kcal / day</strong>
        </div>
      </div>

      <!-- Allergies & Medical Conditions -->
      <div style="margin-top:20px; padding-top:16px; border-top:1px solid var(--neutral-100); display:grid; gap:12px;">
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
          <span style="font-size:13px; font-weight:700; color:#b91c1c;">CLINICAL ALLERGIES:</span>
          <% if (user.allergies && user.allergies.length > 0) { %>
            <% user.allergies.forEach(function(a) { %>
              <span class="badge-pill badge-danger"><%= a %></span>
            <% }); %>
          <% } else { %>
            <span style="font-size:13px; color:var(--neutral-500);">None recorded</span>
          <% } %>
        </div>

        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
          <span style="font-size:13px; font-weight:700; color:#b45309;">HEALTH CONDITIONS:</span>
          <% if (user.healthConditions && user.healthConditions.length > 0) { %>
            <% user.healthConditions.forEach(function(c) { %>
              <span class="badge-pill badge-warning"><%= c %></span>
            <% }); %>
          <% } else { %>
            <span style="font-size:13px; color:var(--neutral-500);">None recorded</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Clinical BMI Evaluation -->
    <div class="card-glass" style="margin-bottom:28px;">
      <h3 style="margin:0 0 8px; font-size:18px; font-weight:700;">Clinical BMI Classification</h3>
      <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <div style="font-size:28px; font-weight:800; color:var(--primary-emerald-dark);"><%= bmi || '--' %></div>
        <div>
          <strong style="font-size:16px; color:var(--neutral-900);"><%= status || 'Pending weigh-in' %></strong>
          <p style="margin:2px 0 0; font-size:14px; color:var(--neutral-500);">
            Calculated dynamically using World Health Organization (WHO) BMI ranges.
          </p>
        </div>
      </div>
    </div>

    <!-- Latest Health Log Entry -->
    <% if (latestLog) { %>
      <div class="card-glass">
        <h3 style="margin:0 0 14px; font-size:18px; font-weight:700;">Latest Recorded Health Log</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:16px;">
          <div>
            <div style="font-size:12px; color:var(--neutral-500); font-weight:700;">LOGGED DATE</div>
            <strong style="color:var(--neutral-800);"><%= new Date(latestLog.date).toLocaleDateString() %></strong>
          </div>
          <div>
            <div style="font-size:12px; color:var(--neutral-500); font-weight:700;">WEIGHT</div>
            <strong style="color:var(--neutral-800);"><%= latestLog.weight %> kg</strong>
          </div>
          <div>
            <div style="font-size:12px; color:var(--neutral-500); font-weight:700;">HYDRATION</div>
            <strong style="color:#0284c7;"><%= latestLog.waterIntakeMl %> ml</strong>
          </div>
          <div>
            <div style="font-size:12px; color:var(--neutral-500); font-weight:700;">DAILY ADHERENCE</div>
            <strong style="color:var(--primary-emerald-dark);"><%= latestLog.adherenceScore || 85 %>%</strong>
          </div>
        </div>
      </div>
    <% } %>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
